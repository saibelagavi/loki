{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOKI",
  "version": "0.1.0",
  "identifier": "com.sainathbelagavi.loki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LOKI",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#16132F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "publisher": "Sainath Belagavi",
    "copyright": "Copyright 2026 Sainath Belagavi",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Encrypted, offline inventory of .env files",
    "longDescription": "LOKI keeps an encrypted, offline inventory of .env files across projects, branches and stages, and shows what differs between staging and production before you push."
  }
}
