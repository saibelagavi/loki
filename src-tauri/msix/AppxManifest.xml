<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for the Microsoft Store build. `npm run build:msix` fills in the version.
  Identity values come from Partner Center (Product management > Product identity) and must match
  it exactly, or the upload is rejected.

  Data safety: exactly one folder, %LOCALAPPDATA%\LOKI, is excluded from file system write
  virtualization (with the unvirtualizedResources capability), so the vault lives in the real
  folder. Virtualized, Windows would redirect it into the package's private storage and DELETE it
  on uninstall, and the Store build and the .msi/.exe build would see different vaults.
  Everything else stays virtualized, registry writes included.

  The per-folder exclusion only exists on Windows 11; Windows 10 ignores it. That is why
  MinVersion is Windows 11 (10.0.22000): on Windows 10 the vault would be virtualized. Windows 10
  users install the .msi/.exe from GitHub Releases instead.

  Microsoft Store certification (2026-11-18) denied the broad desktop6 "disabled" switch; do not
  bring it back. build-msix.mjs checks all of this before packing.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap rescap virtualization">

  <Identity
    Name="sainathbelagavi.LOKI-LocalOnlyKeyInventory"
    Publisher="CN=5460F997-CA94-411E-9AD5-02A57B14112F"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>LOKI - Local Only Key Inventory</DisplayName>
    <PublisherDisplayName>sainath belagavi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Encrypted, offline inventory of .env files</Description>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\LOKI</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <!-- 10.0.22000 = Windows 11, the first version that honours ExcludedDirectories. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="LOKI" Executable="loki.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="LOKI - Local Only Key Inventory"
        Description="Encrypted, offline inventory of .env files"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <!-- No internetClient capability: LOKI never uses the network. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
